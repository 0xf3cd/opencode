---
import type { HTMLAttributes } from "astro/types"
import { docsLocaleFromUrl, localizeDocsHref } from "../lib/language"

type Props = HTMLAttributes<"a">

const href = Astro.props.href?.toString()
const attributes = { ...Astro.props, href: href && localizeDocsHref(href, docsLocaleFromUrl(Astro.url)) }
---

<a {...attributes}><slot /></a>
