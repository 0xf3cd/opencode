---
import { useI18n } from "../i18n"
import { docsLocaleFromUrl } from "../lib/language"

interface Props {
  type?: "note" | "tip" | "warning"
  title?: string
}

const type = Astro.props.type ?? "note"
const title = Astro.props.title ?? useI18n(docsLocaleFromUrl(Astro.url)).t(`callout.${type}`)
---

<aside class={`callout callout-${type}`} aria-label={title}>
  <strong>{title}</strong>
  <div><slot /></div>
</aside>
