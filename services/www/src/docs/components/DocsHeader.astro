---
import { useI18n } from "../i18n"
import { defaultLocale, v1DocsHref, type DocsLocale } from "../lib/language"
import { docsHref, docsSections, getDocsSection } from "../lib/navigation"

interface Props {
  locale: DocsLocale
  currentSlug: string
}

const locale = Astro.props.locale
const i18n = useI18n(locale)
const currentSlug = Astro.props.currentSlug
const currentSection = getDocsSection(currentSlug)
const searchEnabled = import.meta.env.PROD
---

<header class="site-header">
  <div class="header-inner">
    <a
      class="brand"
      href={locale === defaultLocale ? import.meta.env.BASE_URL : docsHref("index", locale)}
      aria-label={i18n.t("nav.home")}
    >
      <img src={`${import.meta.env.BASE_URL}assets/logo-dark.svg`} alt="OpenCode" />
    </a>
    <nav aria-label={i18n.t("nav.sections")}>
      {
        docsSections.map((section) => (
          <a
            href={docsHref(section.landingSlug, locale)}
            aria-current={currentSection.key === section.key ? "page" : undefined}
          >
            {i18n.nav(section.title)}
          </a>
        ))
      }
      <a href={v1DocsHref(locale)}>V1</a>
    </nav>
    <div class="header-spacer"></div>
    {
      searchEnabled && (
        <button class="search-trigger" type="button" data-search-open aria-label={i18n.t("search.label")}>
          <span>{i18n.t("search.button")}</span><kbd>⌘K</kbd>
        </button>
      )
    }
    <a class="github-link" href="https://github.com/anomalyco/opencode" aria-label={i18n.t("nav.github")}>GitHub</a>
  </div>
</header>

{
  searchEnabled && (
    <dialog
      class="search-dialog"
      data-search-dialog
      data-pagefind-path={`${import.meta.env.BASE_URL}docs/pagefind/pagefind.js`}
      data-base-url={`${import.meta.env.BASE_URL}docs/`}
      data-empty={i18n.t("search.empty")}
      data-no-results={i18n.t("search.noResults")}
      aria-label={i18n.t("search.label")}
    >
      <form method="dialog" class="search-bar">
        <span aria-hidden="true">&gt;</span>
        <input data-search-input type="search" placeholder={i18n.t("search.placeholder")} autocomplete="off" />
        <button type="submit" aria-label={i18n.t("search.close")}>Esc</button>
      </form>
      <div class="search-results" data-search-results>
        <p>{i18n.t("search.empty")}</p>
      </div>
    </dialog>
  )
}

<script is:inline>
  let pagefind
  let pagefindLanguage

  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault()
      const dialog = document.querySelector("[data-search-dialog]")
      dialog?.showModal()
      dialog?.querySelector("[data-search-input]")?.focus()
    }
  })

  const setupSearch = () => {
    const dialog = document.querySelector("[data-search-dialog]")
    const input = document.querySelector("[data-search-input]")
    const results = document.querySelector("[data-search-results]")
    const trigger = document.querySelector("[data-search-open]")
    if (trigger && !trigger.dataset.searchReady) {
      trigger.dataset.searchReady = "true"
      trigger.addEventListener("click", () => {
        dialog?.showModal()
        input?.focus()
      })
    }

    if (input && results && !input.dataset.searchReady) input.addEventListener("input", async () => {
      input.dataset.searchReady = "true"
      const query = input.value.trim()
      if (!query) {
        const empty = document.createElement("p")
        empty.textContent = dialog?.dataset.empty ?? ""
        results.replaceChildren(empty)
        return
      }

      const pagefindPath = dialog?.dataset.pagefindPath
      if (!pagefindPath) return
      const api = pagefind ?? (pagefind = await import(pagefindPath))
      // Pagefind loads the index for the page language once. Client-side navigation can change the language,
      // for example through the language picker or history navigation, so reset it when the page language changes.
      const language = document.documentElement.lang
      if (pagefindLanguage !== undefined && pagefindLanguage !== language) await api.destroy()
      pagefindLanguage = language
      const search = await api.search(query)
      const pages = await Promise.all(search.results.slice(0, 8).map((result) => result.data()))
      results.replaceChildren(
        ...pages.map((page) => {
          const link = document.createElement("a")
          const base = dialog.dataset.baseUrl ?? "/"
          link.href = page.url.startsWith(base)
            ? page.url
            : `${dialog.dataset.baseUrl?.replace(/\/$/, "")}${page.url}`
          const title = document.createElement("strong")
          title.textContent = page.meta.title
          const excerpt = document.createElement("span")
          excerpt.innerHTML = page.excerpt
          link.append(title, excerpt)
          return link
        }),
      )
      if (!pages.length) {
        const empty = document.createElement("p")
        empty.textContent = dialog.dataset.noResults ?? ""
        results.replaceChildren(empty)
      }
    })
  }

  setupSearch()
  document.addEventListener("astro:page-load", setupSearch)
</script>

