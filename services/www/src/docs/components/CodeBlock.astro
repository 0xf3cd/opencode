---
import { useI18n } from "../i18n"
import { docsLocaleFromUrl } from "../lib/language"

interface Props {
  code: string
}

const i18n = useI18n(docsLocaleFromUrl(Astro.url))
---

<div class="docs-code-block">
  <pre><code>{Astro.props.code}</code></pre>
  <button
    type="button"
    data-copy-code
    data-code={Astro.props.code}
    data-label={i18n.t("code.copy")}
    data-copied-label={i18n.t("page.copied")}
  >
    {i18n.t("code.copy")}
  </button>
</div>

<script>
  document.addEventListener("click", async (event) => {
    const button = event.target
    if (!(button instanceof HTMLButtonElement) || !button.matches("[data-copy-code]")) return
    await navigator.clipboard.writeText(button.dataset.code ?? "")
    button.textContent = button.dataset.copiedLabel ?? ""
    window.setTimeout(() => (button.textContent = button.dataset.label ?? ""), 1500)
  })
</script>
