---
import { docsLocaleFromUrl, localizeDocsHref } from "../lib/language"

interface Props {
  title: string
  href: string
}

const href = Astro.props.href.startsWith("/")
  ? localizeDocsHref(`${import.meta.env.BASE_URL}docs${Astro.props.href}`, docsLocaleFromUrl(Astro.url))
  : Astro.props.href
---

<a class="docs-card" href={href}>
  <strong>{Astro.props.title}</strong>
  <div><slot /></div>
</a>
