---
import OpenApiReference from "../../../../docs/components/OpenApiReference.astro"
import DocsLayout from "../../../../docs/layouts/DocsLayout.astro"
import { defaultLocale, docsLocaleKeys, type DocsLocale } from "../../../../docs/lib/language"

interface Props {
  locale: DocsLocale
}

export function getStaticPaths() {
  return docsLocaleKeys.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }))
}

export const prerender = true
---

<DocsLayout
  title="API"
  description="OpenCode HTTP API reference and OpenAPI specification."
  locale={Astro.props.locale}
  currentSlug="api"
  headings={[]}
  showTableOfContents={false}
  fullWidth
>
  <OpenApiReference />
</DocsLayout>
