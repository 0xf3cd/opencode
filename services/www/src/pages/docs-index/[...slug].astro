---
import DocsPage from "../../docs/components/DocsPage.astro"
import { defaultLocale } from "../../docs/lib/language"
import { getDocsPages } from "../../docs/lib/pages"

type Props = Awaited<ReturnType<typeof getDocsPages>>[number]

export async function getStaticPaths() {
  return (await getDocsPages()).map((page) => ({
    params: {
      slug:
        [page.locale === defaultLocale ? "" : page.locale, page.slug.replace(/(^|\/)index$/, "")]
          .filter(Boolean)
          .join("/") || undefined,
    },
    props: page,
  }))
}

export const prerender = true
---

<DocsPage {...Astro.props} />
