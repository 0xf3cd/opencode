{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/plugin-genui",
  "version": "2.0.27",
  "description": "OpenCode's generative UI plugin",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/plugin-genui"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
